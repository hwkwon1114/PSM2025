{
  "description": "Enhanced adaptive cutback solver configuration starting at full load lambda=1.0 with deterministic max_hessians=40 and direct bisection cutback upon Newton stall.",
  "options": {
    "-equilibrium_solver": "native_hybrid",
    "-sequence_adaptive": "true",
    "-sequence_initial_step": "1.0",
    "-sequence_max_step": "1.0",
    "-sequence_min_step": "0.015625",
    "-sequence_step_growth": "2.0",
    "-sequence_max_retries": "8",
    "-sequence_warm_start": "true",
    "-sequence_minimize_every": "1",
    "-sequence_slope_feedback": "0",
    "-equilibrium_grad_tol": "5e-14",
    "-native_hybrid_grad_tol": "5e-14",
    "-native_hybrid_refine_linear_solve": "true",
    "-native_hybrid_warmup_attempts": "2000",
    "-native_hybrid_max_hessians": "40",
    "-native_hybrid_seconds": "1800",
    "-native_hybrid_on_newton_stall": "cutback",
    "-native_hybrid_newton_stall_window": "5",
    "-native_hybrid_newton_stall_ratio": "0.85",
    "-native_hybrid_newton_stall_grace": "10",
    "-native_hybrid_max_newton_stalls": "2",
    "-native_hybrid_max_newton_indefinite": "3",
    "-native_hybrid_handoff": "fixed",
    "-native_hybrid_export_state": "true",
    "-seed_escape": "false",
    "-hessian_threads": "8"
  }
}
