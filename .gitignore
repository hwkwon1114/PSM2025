# Ignore the SLURM run workspace (convergence/sensitivity studies, raw outputs)
scratch/

# Ignore oh-my-claudecode state
.omc/

# Ignore the build, lib, doc dirs and run/* scripts
build
build_cmake
build_cmake/*
build_hlbfgs
lib/*
doc
run/*
patches/*

# Ignore the Xcode stuff
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/
xcuserdata/


# Ignore any executables
bin/*

# Ignore data files
*.dat

# Ignore Mac specific files
.DS_Store

# Ignore emacs files
*~

# Appcode shit
.idea/*

# Reference PDFs (copyrighted; keep README.md map only, not the papers)
paper_list/*.pdf

# Build logs
bld.log
cfg.log

# Local agent/runtime state
.omx/

# Python caches and generated checkpoints
__pycache__/
*.py[cod]
.pytest_cache/
*.npy
python/*.png

# Raw experiment outputs and one-off root jobs
uq_runs/
scratch_*
core
core.*
