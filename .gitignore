# Ignore the SLURM run workspace (convergence/sensitivity studies, raw outputs)
.srun_here
scratch/
archive/
.pi/
package-lock.json
/*.stl

# AI assistant and agent files
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.copilot/

# Ignore the build, lib, doc dirs and run/* scripts
build
build_cmake
build_cmake/*
build_hlbfgs
lib/*
doc
run/*
patches/*

# Ignore the Xcode stuff
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
project.xcworkspace/
xcuserdata/


# Ignore any executables
bin/*

# Ignore data files
*.dat

# Ignore Mac specific files
.DS_Store

# Ignore emacs files
*~

# Appcode shit
.idea/*

# Private research documentation, drafts, and publication figures (local only)
docs/
calibration/paper_figures/

# Build logs
bld.log
cfg.log

# Python caches and generated checkpoints
checkpoint_test_*/
__pycache__/
*.py[cod]
.pytest_cache/
*.npy
python/*.png

# Raw experiment outputs and one-off root jobs
uq_runs/
scratch_*
core
core.*
Testing/
argumentparser.log
.obsidian/
.omp/
calibration/data/raw/*
calibration/data/processed/*
/bilayer_zigzag_sequence_*.csv
/bilayer_zigzag_sequence_*.vtp
/sequence_*.csv
/sequence_*.json
/sequence_history.csv


# LaTeX build artifacts
docs/**/*.aux
docs/**/compile.stdout

